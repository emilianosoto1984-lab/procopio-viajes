{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "procopio-forms-form-customizer": {
      "components": [
        {
          "entrypoint": "./lib/extensions/procopioForms/ProcopioFormsFormCustomizer.js",
          "manifest": "./src/extensions/procopioForms/ProcopioFormsFormCustomizer.manifest.json"
        }
      ]
    },
    "registro-pagos-form-form-customizer": {
      "components": [
        {
          "entrypoint": "./lib/extensions/registroPagosForm/RegistroPagosFormFormCustomizer.js",
          "manifest": "./src/extensions/registroPagosForm/RegistroPagosFormFormCustomizer.manifest.json"
        }
      ]
    },
    "vista-caja-consolidada-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/vistaCajaConsolidada/VistaCajaConsolidadaWebPart.js",
          "manifest": "./src/webparts/vistaCajaConsolidada/VistaCajaConsolidadaWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "ProcopioFormsFormCustomizerStrings": "lib/extensions/procopioForms/loc/{locale}.js",
    "RegistroPagosFormFormCustomizerStrings": "lib/extensions/registroPagosForm/loc/{locale}.js",
    "VistaCajaConsolidadaWebPartStrings": "lib/webparts/vistaCajaConsolidada/loc/{locale}.js"
  }
}
